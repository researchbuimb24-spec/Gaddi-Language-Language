    "phonotactics_and_syllable": {
      "canonical_syllable": "(C)(C)(V)(C)",
      "sonority_hierarchy": "Plosives < Fricatives < Nasals < Laterals < Flaps < Vowels",
      "syllable_principles": [
        "Onset Maximisation Principle (Kahn 1980): Intervocalic single consonants assigned to following onset",
        "Geminates split across coda and onset: sut.tu.rɑ, tʃiʈ.ʈʰi, bər.kkʰɑ",
        "Homorganic oral plosive clusters (unaspirated + aspirated) syllabify as geminates"
      ],
      "word_initial_clusters": [
        "/br/",
        "/dr/",
        "/ɡr/",
        "/kr/",
        "/ɡl/",
        "/pj/",
        "/sʋ/"
      ],
      "word_final_codas": "Rare due to excrescent schwa /ə/ release; only /ɾ/, /m/, /s/ occur word-finally without schwa"
    },
    "phonological_processes": [
      {
        "name": "Regressive Nasal Spread",
        "rule": "V -> Ṽ / __ [+nasal]",
        "direction": "right to left",
        "examples": [
          "lɔŋɡ -> lɔ̃ŋɡ",
          "tʃɛnʈe -> tʃɛ̃nʈe",
          "kɑŋɡi -> kɑ̃ŋɡi",
          "mɑndʒ -> mɑ̃ndʒ"
        ]
      },
      {
        "name": "Prenasalisation",
        "environment": "word-initially before voiced plosives",
        "examples": [
          "[ᵐbinnɑ] (mattress)",
          "[ᵐbəsəndə] (summer)",
          "[ᵐbɑːldə] (bull)",
          "[ᵐbəɾkʰɑ] (rain)",
          "[ⁿɖəkka] (push)",
          "[ⁿda:rə] (door)",
          "[ᵑgəttə] (big flower)",
          "[ᵑgirka] (heavy)"
        ]
      },
      {
        "name": "Gemination",
        "types": "derived (across morpheme boundary with ergative -ɛ on sonorants) vs underived",
        "examples": [
          "ɾɑm + ɛ -> ɾɑmmɛ",
          "sjɑm + ɛ -> sjɑmmɛ",
          "nikkɑ (child)",
          "buʈʈɑ (tree)",
          "dʒɑnnu (knee)"
        ]
      },
      {
        "name": "Loanword Schwa Epenthesis",
        "purpose": "break illegal clusters in borrowings",
        "examples": [
          "/skuːl/ -> [səkul]",
          "/pʌrs/ -> [pərəs]",
          "/film/ -> [pʰiləm]",
          "/bʌlb/ -> [bələb]"
        ]
      },
      {
        "name": "Glide Epenthesis",
        "rule": "Ø -> [j] / V1_V2",
        "purpose": "hiatus resolution across vowel collocation",
        "examples": [
          "[ijũ] (snow)",
          "[tʃəlijɑ] (come)",
          "[sejɑu] (apple)",
          "post-lexical before mood marker: dʒərurijɑ, indi(j)ɑ"
        ]
      },
      {
        "name": "Lyman's Law / OCP Retroflex Dissimilation",
        "rule": "Prohibits two adjacent aspirated retroflex consonants",
        "examples": [
          "[piʈʈʰi] (back)",
          "[piʈʈʰɑ] (dough)",
          "[miʈʈʰe] (sweet)"
        ]
      }
    ],
    "appendix_i_discrepancies": {
      "vowels": "Appendix I Table A.2 lists 5 nasal vowels (ĩ, ũ, ẽ, ə̃, ɑ̃), whereas Chapter 2 Section 2.2.2 establishes exactly 3 lexical nasal vowels (/ũ/, /ɑ̃/, /ɛ̃/).",
      "consonants": "Appendix I Table A.3 includes fricatives /f/ and /ʃ/, velar nasal /ŋ/ as a full phoneme, and trill /r/ alongside flap /ɽ/, whereas Chapter 2 Table 2.4 restricts fricatives to /s, h/, treats [ŋ] as an allophone of /n/ before velars, and lists only flap /ɾ/."
    }
  },

    "nominal_morphology": {
      "gender_system": {
        "type": "two_way",
        "values": [
          "masculine",
          "feminine"
        ],
        "phonological_tendencies": "Vowel /u/ typically masculine; vowel /i/ typically feminine; consonant-final variable",
        "natural_gender_overrides": true,
        "semantic_classes": {
          "ornaments": "all feminine (matika, bɑ:li, kəɖoɭi)",
          "days_of_week": "all masculine (tuɑr, suɑr, breb)"
        }
      },
      "number_system": {
        "values": [
          "singular",
          "plural"
        ],
        "count_nouns": "Inflect for plural: -ɑ stems change to -e (nikkɑ -> nikke, buɖʰɑ -> buɖʰe); consonant stems add -ɑ (pɑɽ -> pɑɽɑ, kətɑb -> kətɑbɑ̃); zero inflection (urnu sg/pl)",
        "mass_nouns": "Do not manifest plural number (teɭi 'oil', čəuɭ 'rice', kʰənɖ 'sugar', kʰɑɳɑ 'food', tɔ:dʒurbɑ: 'experience')"
      },
      "case_markers_and_adpositions": [
        {
          "case": "nominative",
          "marker": "Ø (zero marked)",
          "type": "noun_dependent",
          "function": "Subject of intransitives, and transitive subjects in imperfective/progressive"
        },
        {
          "case": "accusative",
          "marker": "-dʒo / -o",
          "type": "noun_dependent",
          "function": "Direct object marking; -o is only used on direct objects, never on indirect objects"
        },
        {
          "case": "dative",
          "marker": "-dʒo",
          "type": "noun_dependent",
          "function": "Indirect objects (goals/beneficiaries) and experiencer subjects (pəŋkədʒɑ-dʒo bʰukə ləɡ-ur-i hɑ)"
        },
        {
          "case": "ergative",
          "marker": "-ɛ (with sonorant gemination on stems) or suppletive oblique",
          "type": "noun_dependent",
          "function": "Subject of transitive verbs in perfect tense and perfective aspect (aspect-based split)"
        },
        {
          "case": "oblique",
          "marker": "stem suppletion: vowel stems unchanged; consonant stems undergo gemination + -ɑ (bisɑl -> bisɑllɑ, rɑm -> rəmmɑ)",
          "type": "noun_dependent",
          "function": "Required base for all postpositions and case markers"
        },
        {
          "case": "subject_oblique",
          "marker": "suppletive oblique stem without overt case suffix",
          "type": "noun_dependent",
          "function": "Marks subjects of irrealis mood (future/unrealized events); blocks subject agreement"
        },
        {
          "case": "ablative",
          "marker": "tʰaũ / hɔ / haũ",
          "type": "noun_independent_adposition",
          "function": "Movement away from source, temporal origin, standard of comparison"
        },
        {
          "case": "instrumental",
          "marker": "-te / -hoɡɡi / -sɔɡi",
          "type": "noun_independent_adposition",
          "function": "Instrument of action or comitative accompaniment"
        },
        {
          "case": "locative",
          "marker": "pur / məndʒ",
          "type": "noun_independent_adposition",
          "function": "Spatial/temporal location ('on' = pur, 'in/inside' = məndʒ)"
        }
      ]
    },
